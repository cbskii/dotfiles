{
	"layer": "top",
	"modules-left": ["cpu", "memory"],
	"modules-center": ["hyprland/workspaces"],
	"modules-right": ["wireplumber", "network", "clock", "battery"],

	"hyprland/workspaces": {
		"format": "{name}: {icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"5": "",
			"default": "",
		},
	},

	"wireplumber": {
		"format": "{icon} {volume}%",
		"format-muted": "   0%",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format-icons": ["", "", ""]
	},

	"network": {
		"tooltip": false,
		"format-wifi": " ",
		"format-ethernet": " ",
		"format-disconnected": " !"
	},

	"clock": {
		"format": "{: %I:%M %p   %d/%m/%Y}"
	},

	"cpu": {
		"interval": 15,
		"format": " {}%",
		"max-length": 10
	},

	"memory": {
		"interval": 30,
		"format": " {}%",
		"max-length": 10
	},
}
